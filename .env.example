# Base URL of the AI Planner backend (see ../backend)
VITE_AI_PLANNER_API_URL=http://localhost:4000/api

# Optional: base URL of the real Trip Feasibility Engine, used when the user
# edits destinations/days/hours from within the planner and the trip needs to
# be re-checked before a new plan is requested. Falls back to the backend's
# /feasibility/mock-check stub if unset -- see backend/README notes.
VITE_FEASIBILITY_ENGINE_URL=http://localhost:8080/api/feasibility
